# Docker resource names
VOLUME_NAME="ros2tutorial-home"
CONTAINER_NAME="ros2tutorial"

# Remote SSH target for backups
REMOTE_USER="ubuntu"
REMOTE_HOST="your.server.com"
REMOTE_PORT="22"
REMOTE_DIR="/srv/ros2_backups"

# Optional: path to SSH private key (e.g., /home/me/.ssh/id_ed25519). Leave empty to use default.
SSH_IDENTITY_FILE=""
