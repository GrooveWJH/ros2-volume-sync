# Docker resource names
VOLUME_NAME="ros2tutorial-home"
CONTAINER_NAME="ros2tutorial"

# Remote SSH target for backups
REMOTE_USER="ubuntu"
REMOTE_HOST="your.server.com"
REMOTE_PORT="22"
REMOTE_DIR="/srv/ros2_backups"

# Optional: path to SSH private key (e.g., /home/me/.ssh/id_ed25519). Leave empty to use default.
SSH_IDENTITY_FILE=""

# Optional: extra SSH options (e.g., keepalive). Example: SSH_EXTRA_OPTS="-o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o IPQoS=throughput"
SSH_EXTRA_OPTS=""

# Optional: limit rsync upload bandwidth (kBytes/s). Leave empty for unlimited.
RSYNC_BW_LIMIT=""

# Optional: maximum rsync retry attempts before falling back to scp.
RSYNC_MAX_RETRIES="3"

# Auto restart containers after push/pull even if they were not running initially.
FORCE_CONTAINER_RESTART="true"

# Remote retention: limit total size of ${REMOTE_DIR} (in GB). Empty disables cleanup.
REMOTE_STORAGE_MAX_GB=""
# If true, keep at least one backup even if it exceeds REMOTE_STORAGE_MAX_GB.
REMOTE_STORAGE_KEEP_ONE="true"
